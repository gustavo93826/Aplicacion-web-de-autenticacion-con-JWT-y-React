# Copia este archivo como ".env.local" y rellena los valores.
# NUNCA subas ".env.local" a Git.

# Secreto para firmar las sesiones (JWT). Mínimo 32 caracteres.
# Genéralo con este comando:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=



# (Opcional) Ruta del archivo de la base de datos.
# Si lo dejas vacío se usa ./data/app.db
# En un servidor real debe apuntar a un disco persistente.
DATABASE_PATH=